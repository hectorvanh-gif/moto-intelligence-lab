{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|bingbot|facebookexternalhit|whatsapp|twitterbot|telegrambot|slackbot|linkedinbot|discordbot).*"
        }
      ],
      "destination": "/api/tarjeta?ruta=/$1"
    },
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
